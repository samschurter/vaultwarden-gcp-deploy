# ddclient.conf (Cloudflare).
# Generated by utilities/create-gcp-secrets.sh from this template, with values
# filled from your setup answers and stored in Secret Manager. For a manual
# install, copy this file to ddns/ddclient.conf and fill in the values marked
# with double underscores yourself.
# utilities/update-dns.sh runs ddclient once per boot and supplies the VM's
# metadata external IPv4. It overrides discovery settings in existing secrets.
# Direct invocation requires an IPv4 override; no external IP lookup is needed.
use=disabled
usev4=disabled
usev6=disabled

# Token must have Zone:DNS:Edit and Zone:Zone:Read, scoped to the target zone.
# ddclient maintains the hostname record below. If first boot fails to create it,
# add a DNS-only A record once and let ddclient update it afterward.
protocol=cloudflare
server=api.cloudflare.com/client/v4
zone=__ZONE__

# TTL: 1 == "Auto" in Cloudflare
ttl=1

login=token
password=__CLOUDFLARE_TOKEN__
__HOSTNAME__
